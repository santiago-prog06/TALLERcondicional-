Algoritmo Mayor a
	Definir a, b Como entero
	escribir "Ingrese el primero numero"
	leer a
	escribir "Ingrese el segundo numero"
	leer b
	Si a > b Entonces
		escribir "El primer numero ", a " es mayor a ", b
	SiNo
		si  a == b Entonces
			escribir "Los dos numeros son iguales"
		sino
			escribir "El segundo numero " , b " es mayor a ", a
		FinSi
	FinSi
FinAlgoritmo
