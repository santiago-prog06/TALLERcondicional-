Algoritmo Intervalo
	Definir num, valormi, valorma Como Entero
	Escribir "Ingrese su numero"
	leer num
	Escribir "Ingrese el valor minimo del intervalo"
	leer valormi
	Escribir "Ingrese el valor maximo del intervalo"
	leer valorma
	Si num >= valormi Y num <= valorma Entonces
		Escribir "Tu numero se encuentra por dentro del intervalo"
	SiNo
		Escribir "Tu numero se encuentra por fuera del intervalo"
	Fin Si
	
FinAlgoritmo
